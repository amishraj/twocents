{
  "name": "budget-tracker",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadlessNoSandbox --code-coverage",
    "test:rules": "firebase emulators:exec --only firestore \"jest --runInBand\"",
    "lint": "ng lint",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "migrate:roles": "tsx scripts/migrate-member-roles.ts",
    "migrate:local-date": "tsx scripts/migrate-local-date.ts"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/router": "^19.2.0",
    "@angular/service-worker": "^19.2.19",
    "chart.js": "^4.5.1",
    "firebase": "^12.10.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.8",
    "@angular-eslint/builder": "^19.0.0",
    "@angular-eslint/eslint-plugin": "^19.0.0",
    "@angular-eslint/eslint-plugin-template": "^19.0.0",
    "@angular-eslint/schematics": "^19.0.0",
    "@angular-eslint/template-parser": "^19.0.0",
    "@angular/cli": "^19.2.8",
    "@angular/compiler-cli": "^19.2.0",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/jasmine": "~5.1.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "angular-eslint": "^19.8.1",
    "eslint": "^9.0.0",
    "firebase-admin": "^12.0.0",
    "firebase-tools": "^13.0.0",
    "jasmine-core": "~5.6.0",
    "jest": "^29.7.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ts-jest": "^29.1.0",
    "tsx": "^4.0.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.0.0"
  }
